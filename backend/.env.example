# Copy these settings into backend/.env and provide your own values.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
MONGO_URI=mongodb://127.0.0.1:27017/joblens
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Google OAuth: register this callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# http://localhost:5000/api/auth/oauth/google/callback

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
